# Hidden pages — block indexing at HTTP level (backs up the noindex meta tags)
/p/*
  X-Robots-Tag: noindex, nofollow

/clients/*
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/reports/*
  X-Robots-Tag: noindex, nofollow

/agreements/*
  X-Robots-Tag: noindex, nofollow

/discovery-call.html
  X-Robots-Tag: noindex, nofollow

/strategy-session.html
  X-Robots-Tag: noindex, nofollow

# Security headers for all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; form-action 'self';
